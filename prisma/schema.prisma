// sellerbricks-bot 전용 DB (셀러브릭스·스튜디오 DB 와 완전히 별개)
// 지금은 SQLite. 나중에 PostgreSQL/MySQL 로 바꿀 때는 provider 와 DATABASE_URL 만 바꾸고 db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 관리자 설정 (AI 선택, 암호화된 API 키, 플랫폼 연결 설정 등) — key/value
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 챗봇 사용자 — 카카오(오픈빌더 botUserKey) / 웹챗·앱(web:랜덤키) / 관리자 테스트
model BotUser {
  id            String          @id @default(cuid())
  botUserKey    String          @unique
  channel       String          @default("KAKAO") // KAKAO | WEB | TEST
  blockedAt     DateTime? // 운영자 차단
  blockReason   String?
  createdAt     DateTime        @default(now())
  lastSeenAt    DateTime        @default(now())
  links         PlatformLink[]
  chats         ChatLog[]
  prefs         SellerPref[]
  drafts        ProductDraft[]
  artifacts     Artifact[]
  sessions      WebSession[]
  notifications Notification[]
  mcpTokens     McpToken[]
}

// 웹챗·앱 로그인 세션 (쿠키 값의 sha256 만 저장, 30일)
model WebSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  botUserId  String
  botUser    BotUser   @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  client     String    @default("WEB") // WEB | APP
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([botUserId])
}

// 알림 (아침 요약·방송 리포트·미입금·송장 지연·취소) — 웹·앱은 알림함, 카카오는 알림톡(지금은 가짜 발송)
model Notification {
  id        String    @id @default(cuid())
  botUserId String
  botUser   BotUser   @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  kind      String // MORNING | LIVE_REPORT | UNPAID | UNSHIPPED | CANCEL | SYSTEM
  title     String
  body      String
  linkUrl   String?
  channel   String // WEB | APP | KAKAO
  status    String // SENT | MOCK_SENT | FAILED
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([botUserId, createdAt])
}

// 외부 AI(MCP) 접속 토큰 — 셀러별, 관리자 화면에서 발급 (sha256 만 저장)
model McpToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  prefix     String
  label      String
  botUserId  String
  botUser    BotUser   @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// 관리자 설정 변경 이력
model AdminAudit {
  id        String   @id @default(cuid())
  action    String
  detail    String   @default("")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 챗봇 사용자 ↔ 플랫폼 계정 연결 (셀러브릭스 / 스튜디오 각각 선택적)
model PlatformLink {
  id          String   @id @default(cuid())
  botUserId   String
  botUser     BotUser  @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  platform    String // SELLERBRICKS | STUDIO
  accountId   String
  accountName String
  linkToken   String // 플랫폼이 발급한 셀러별 연결 토큰 (암호화 저장)
  createdAt   DateTime @default(now())

  @@unique([botUserId, platform])
}

// 가짜 플랫폼 전용 — 관리자 화면에서 발급하는 테스트 연결 코드
model MockLinkCode {
  code        String   @id
  platform    String
  accountId   String
  accountName String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

// 대화 로그 (개인정보 가림 처리 후 저장)
model ChatLog {
  id        String        @id @default(cuid())
  botUserId String?
  botUser   BotUser?      @relation(fields: [botUserId], references: [id], onDelete: SetNull)
  channel   String // KAKAO | WEB | APP | TEST | MCP
  userText  String
  replyText String
  provider  String // CLAUDE | GPT | MOCK | SYSTEM
  model     String?
  latencyMs Int           @default(0)
  tokensIn  Int           @default(0)
  tokensOut Int           @default(0)
  error     String?
  checkWarn String? // 숫자 검증 경고 (답변 숫자가 조회 결과에 없을 때)
  feedback  Int? // 1 = 👍, -1 = 👎
  extraJson String? // 카드·버튼·결과 링크 (웹챗 대화 기록 다시 그리기용)
  createdAt DateTime      @default(now())
  tools     ToolCallLog[]

  @@index([createdAt])
  @@index([botUserId, createdAt])
  @@index([channel, createdAt])
}

// 도구 호출 로그
model ToolCallLog {
  id        String   @id @default(cuid())
  chatLogId String
  chatLog   ChatLog  @relation(fields: [chatLogId], references: [id], onDelete: Cascade)
  tool      String
  argsJson  String
  ok        Boolean
  ms        Int
  error     String?
  createdAt DateTime @default(now())
}

// 셀러별 기본 설정 (송장 지연 기준일, 상품 기본 등록 위치 등)
model SellerPref {
  id        String   @id @default(cuid())
  botUserId String
  botUser   BotUser  @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([botUserId, key])
}

// 결과물 (결과 페이지 · CSV · 문서) — 셀러 전용 서명 링크로 열람
model Artifact {
  id          String    @id @default(cuid())
  token       String    @unique
  botUserId   String
  botUser     BotUser   @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  kind        String // REPORT | TABLE | TEXT
  title       String
  payloadJson String
  views       Int       @default(0)
  lastViewAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// 사진 상품 등록 작성 중 내용 (30분 유효)
model ProductDraft {
  id          String   @id @default(cuid())
  botUserId   String
  botUser     BotUser  @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  status      String // COLLECTING | CONFIRM | DONE | CANCELLED
  imagesJson  String   @default("[]") // 봇 서버에 저장한 사진 토큰 목록
  name        String?
  description String?
  price       Int?
  stock       Int? // null = 재고 관리 안 함
  shippingFee Int? // null = 셀러 기본 배송비
  optionsJson String?
  warnings    String? // 광고 문구 점검 결과
  resultJson  String? // 등록 결과 (상품 id, 번호 등)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([botUserId, status])
}

// 업로드된 사진 (카카오 보안 이미지는 링크가 곧 만료되므로 받자마자 저장)
model StoredImage {
  id          String   @id @default(cuid())
  token       String   @unique
  botUserId   String?
  contentType String
  bytes       Bytes
  createdAt   DateTime @default(now())
}

// 콜백 미승인 상태에서 4초를 넘긴 답 — [결과 보기]로 받기
model PendingReply {
  id         String   @id @default(cuid())
  botUserKey String   @unique
  status     String // WORKING | READY
  question   String
  replyJson  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 셀러용 FAQ · 사용법 · 정책 (관리자 화면에서 편집)
model FaqDoc {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  keywords  String   @default("")
  isActive  Boolean  @default(true)
  source    String? // 근거 (셀러브릭스 코드 위치 등)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
