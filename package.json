{
  "name": "sellerbricks-bot",
  "version": "0.1.0",
  "private": true,
  "description": "셀러브릭스 + 셀러브릭스 스튜디오 공용 카카오 채널 챗봇·MCP 서버",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@prisma/client": "5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
