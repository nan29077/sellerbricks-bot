# sellerbricks-bot 환경 설정 예시
# 1_setup.bat 을 실행하면 이 파일이 .env 로 복사됩니다. 값은 .env 에서 바꾸세요.
# (.env 는 Git 에 올라가지 않습니다)

# 개발 서버 포트
PORT=3071

# 관리자 화면 비밀번호 — 반드시 바꾸세요
ADMIN_PASSWORD=admin1234

# 암호화·로그인 서명용 비밀값 (비워 두면 처음 실행 때 data/app-secret.txt 에 자동 생성)
# 이 값을 잃어버리면 관리자 화면에 저장한 API 키를 다시 입력해야 합니다.
APP_SECRET=

# 카카오 스킬 주소 비밀 경로 (비워 두면 자동 생성 — 관리자 화면에서 확인)
KAKAO_SKILL_SECRET=

# SQLite 파일 위치 (나중에 PostgreSQL/MySQL 로 바꿀 수 있음)
DATABASE_URL="file:../data/bot.db"

# 관리자 화면 바로가기 버튼에 쓰는 셀러브릭스 주소
SELLERBRICKS_WEB_URL=https://sellerbricks.co.kr

# (선택) API 키를 여기에 넣어도 됩니다. 관리자 화면에 입력한 키가 있으면 그쪽이 우선합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
